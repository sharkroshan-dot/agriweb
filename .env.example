# ============================================================================
# AgriConnect AI - Environment template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES. NEVER COMMIT .env.
# All keys below are placeholders. Generate strong random secrets for prod.
# ============================================================================

# Application
APP_NAME=AgriConnect AI
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-32+-char-random-secret
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (MongoDB)
# Production: use mongodb+srv:// with TLS + credentials, e.g.
# MONGODB_URI=mongodb+srv://cluster.example.mongodb.net/agriconnect?retryWrites=true&w=majority
# and set MONGODB_USER/MONGODB_PASSWORD + MONGODB_TLS=true + MONGODB_AUTH_SOURCE=admin.
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=agri
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_TLS=false
MONGODB_AUTH_SOURCE=
MONGODB_RETRY_WRITES=true

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Celery (uses same Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT - use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-64-char-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@agriconnect.ai

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE

# RazorpayX Payouts (farmer/delivery withdrawals)
RAZORPAY_PAYOUTS_ENABLED=False
RAZORPAY_PAYOUT_MODE=IMPS
RAZORPAY_PAYOUT_NARRATION=AgriConnect farmer payout
RAZORPAY_PAYOUT_ACCOUNT_ID=

# COD cash-settlement controls
COD_SETTLEMENT_DUE_HOURS=24
COD_MAX_OUTSTANDING=10000.0
COD_PARTNER_COMMISSION_RATE=0.10
COD_FARMER_COMMISSION_RATE=0.85
PICKUP_COMMISSION_RATE=0.05
COD_COLLECTION_UPI_ID=agriconnect@bank
COD_COLLECTION_ACCOUNT_NUMBER=XXXXXXXXXX
COD_COLLECTION_ACCOUNT_NAME=AgriConnect Finance
COD_COLLECTION_ACCOUNT_IFSC=XXXX0000000

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=agriconnect
AWS_REGION=ap-south-1

# Google Maps
GOOGLE_MAPS_API_KEY=REPLACE

# Firebase (Push Notifications)
FIREBASE_SERVER_KEY=REPLACE
FIREBASE_SENDER_ID=REPLACE

# AI Services
AI_MODEL_PATH=./ai/models
DEMAND_PREDICTION_ENABLED=True
PRICE_OPTIMIZATION_ENABLED=True
ROUTE_OPTIMIZATION_ENABLED=True
OPENAI_API_KEY=sk-REPLACE

# Monitoring
SENTRY_DSN=https://REPLACE@ingest.sentry.io/REPLACE
GRAFANA_PASSWORD=change-me

# SMS providers
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=+1234567890

# MSG91 SMS (recommended for reliable delivery to Indian numbers)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4
MSG91_COUNTRY=91

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v20.0

# Email-to-SMS Gateway
SMS_EMAIL_GATEWAY_DOMAIN=

# Public base URL used for the one-tap rating link in delivery SMS.
# In production set this to your public API/domain.
PUBLIC_BASE_URL=http://localhost:8000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Production
API_URL_PROD=https://api.agriconnect.ai
WEBSITE_URL_PROD=https://agriconnect.ai
MONGODB_URI_PROD=mongodb://REPLACE
REDIS_URL_PROD=redis://REPLACE
JWT_SECRET_PROD=REPLACE

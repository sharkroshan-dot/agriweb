# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# RazorpayX Payouts (farmer/delivery withdrawals)
# Set RAZORPAY_PAYOUTS_ENABLED=True to make real bank/UPI transfers.
# When False (or keys missing) the backend simulates successful payouts.
RAZORPAY_PAYOUTS_ENABLED=False
# Transfer mode: IMPS, NEFT, RTGS or UPI
RAZORPAY_PAYOUT_MODE=IMPS
RAZORPAY_PAYOUT_NARRATION=AgriConnect farmer payout
# Optional RazorpayX settlement account number to debit payouts from
RAZORPAY_PAYOUT_ACCOUNT_ID=


# AI Farm Assistant - LLM semantic understanding
# Use an OpenAI-compatible chat-completions endpoint.
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_BASE_URL=https://api.openai.com/v1/chat/completions
AI_ASSISTANT_MODEL=gpt-5.6-luna

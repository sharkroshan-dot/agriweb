{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-codex-fresh/types/**/*.ts",
    ".next-codex/types/**/*.ts",
    ".next-temp/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-persist-test/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "cypress",
    "cypress.config.ts",
    "jest.config.js",
    "jest.setup.js"
  ]
}
